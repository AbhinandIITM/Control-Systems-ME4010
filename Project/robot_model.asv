clc; clear;

% Given LQR gain matrix from previous calculation
K = [-10.0000 -8.1678 67.7306 8.5997];

% Parameters
M_w = 0.5; M_r = 1.0; m_b = 0.3; R = 0.05; h = 0.1; r = 0.02;
I_w = 0.5 * M_w * R^2;
I_r = 0.5 * M_r * (R/2)^2;
g = 9.81;
l = h + r;
M = M_w + M_r + m_b;
A11 = M; A12 = -m_b * l; A21 = -m_b * l; A22 = I_r + m_b * l^2;

% Time span and initial condition
tspan = [0 8];
% Initial condition [x, xdot, theta, thdot]
x0 = [0.05; 0; deg2rad(6); 0];

% Simulate using ode45
[t, z] = ode45(@(t,z) nl_dynamics_lqr(t, z, K, ...
    M_w, M_r, m_b, R, h, r, I_w, I_r, g, l, A11, A12, A21, A22), tspan, x0);

% Plotting
figure;
subplot(2,1,1);
hold on;
plot(t, z(:,1), 'LineWidth', 1.6);
plot(t, z(:,2), 'LineWidth', 1.6,'Color','red');
xlabel('Time [s]');
ylabel('Ball position x [m]');
title('Ball position');
grid on;
hold off

subplot(2,1,2);
plot(t, rad2deg(z(:,3)), 'LineWidth', 1.6);
plot(t, z(:,4), 'LineWidth', 1.6,'Color','red');
xlabel('Time [s]');
ylabel('Tilt angle \theta [deg]');
title('Robot tilt');
grid on;

% Nonlinear dynamics with LQR controller function
function dz = nl_dynamics_lqr(~, z, K, ...
    M_w, M_r, m_b, R, h, r, I_w, I_r, g, l, A11, A12, A21, A22)

    x = z(1);
    xdot = z(2);
    theta = z(3);
    thdot = z(4);
    
    % State vector
    state_vec = [x; xdot; theta; thdot];
    
    % Control input: wheel acceleration u (LQR control law)
    u = -K * state_vec;
    
    % Compute accelerations using coupling system
    A_mat = [A11 A12; A21 A22];
    b_vec = [u; m_b * l * g * theta];
    sol = A_mat \ b_vec;
    
    xwddot = u; % wheel acceleration equals control input
    thetaddot = sol(2);
    xddot = xwddot + l * thetaddot;
    
    % State derivatives
    dz = zeros(4,1);
    dz(1) = xdot;
    dz(2) = xddot;
    dz(3) = thdot;
    dz(4) = thetaddot;
end
