%% Q1
%% (i)
z = [-5];
p = [-2 -4 -7 -9];
k = [1];
G1 = zpk(z,p,k) %[output:72f5a8f1]
% part (a)
%plot rlocus
figure; %[output:2fdc0a75]
rlocus(G1); %[output:2fdc0a75]
%%
% part (b) , (c)
sgrid(0.7,[]) %[output:765d6ff9]
%The dominant Poles are -2.81+2.87i and gain value K=88.9 (observed from the plot)
%%
% part (d)
% design parameters
zeta = 0.7; % damping ratio
Ts = 1; % settling time
zc = -0.3; % desired compensator zero
%settling time = 1 = 4/(zeta*wn) (2nd order approx.)
wn = 4/(zeta*Ts);
wd = wn * sqrt(1 - zeta^2);

sd = -zeta*wn + 1i*wd; % desired dominant closed loop pole, 
                        % rlocus has to pass through this.

%%
% sum(theta_zeros) - sum(theta_poles) = (2n+1)*pi (rad)
angle_G1 = angle(evalfr(G1, sd)) %[output:934454e1]
angle_zc = angle(sd - zc) %[output:8e727cc7]
% Desired total angle must be odd multiple of 180° = pi radians
desired_angle = pi;  % choose +pi (can also take -pi, 3pi, etc.)

% Required angle contribution of compensator pole
angle_pc = angle_G1 + angle_zc - desired_angle %[output:96b646d8]
%%
angle_G1 = angle(evalfr(G1, sd));         
angle_zc = angle(sd - zc);

desired_angle = pi;  

% Required angle contribution of compensator pole
angle_pc = angle_G1 + angle_zc - desired_angle %[output:7631ee95]
%%
pc = real(sd) - imag(sd)/tan(angle_pc) %[output:14d94bbd]
%%
%step response and steaddy state error
sys_comp = zpk([-5 -2],[-2 -4 -7 -9 -5.2218],[88.9]);    
sys_cl = feedback(sys_comp,1);  
step(sys_cl) %[output:2ba2f3f1]
stepinfo(sys_cl) %[output:9c84ed1b]

%steady state error 
Kp = dcgain(sys_comp);
fprintf("for Zc = -4.5, ess = 0.3755") %[output:56181834]
fprintf("for Zc = -2, ess = 0.7475")
ess = 1/(1+Kp);
% steady state error is not zero , due to second order approximation.

%%
%% uncompensated 
step(sys) %[output:5faf6fd7]
sys_uncomp=zpk(z,p,88.9);
Kp_uncomp = dcgain(sys_uncomp) %[output:07afee76]
ess_uncomp = 1/(1+Kp_uncomp) %[output:02639cc0]
% higher ess
%%



