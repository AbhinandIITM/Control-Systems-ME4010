clc ; clear all;
%%

m = 10;     % mass (kg)
k = 1000;   % spring constant (N/m)
c = 10;     % damping coefficient (Ns/m)
u = 0;      % external force input (N)
%%

%% ---------------------- System definition ----------------------
A = [0 1; -k/m -c/m];   % state matrix
B = [0; 1/m];           % input matrix
C = [1 0];              % output matrix
% system poles
p_s = eig(A) %[output:21e64ade]
% Observer pole locations (must be faster than system poles)
p_o = [-2.1, -2.0];

% Observer gain (dual system approach)
Ke = place(A', C', p_o)';

t_sim = 0:0.01:10; % simulation time vector
x0 = [-2 0 10 -1];
%%
function dX = obs_smd_err(t,x,A,C,B,u,Ke)
    zA = zeros(size(A));
    zB = zeros(size(B));
    dX = [A zA ; zA A-Ke*C]*x + [B ; zB]*u;
end
%%
[to,x] = ode45(@(t,x_hat)obs_smd_err(t,x_hat,A,C,B,u,Ke),t_sim,x0);
%%
figure; %[output:7bfe45c0]

subplot(2,2,1); %[output:7bfe45c0]
plot(t_sim, x(:,1),'k-', 'LineWidth', 1.5); hold on; %[output:7bfe45c0]
plot(t_sim, x(:,3), 'b--', 'LineWidth', 1.5); %[output:7bfe45c0]
plot(t_sim, x(:,1) - x(:,3), 'r-.', 'LineWidth', 1.5); %[output:7bfe45c0]
legend('System State x_1','Observer Estimate \xhat_1','Error x_1 - \xhat_1'); %[output:7bfe45c0]
xlabel('Time (s)'); %[output:7bfe45c0]
ylabel('Displacement (m)'); %[output:7bfe45c0]
title('Displacement and Observer Estimation'); %[output:7bfe45c0]
grid on; %[output:7bfe45c0]

subplot(2,2,2); %[output:7bfe45c0]
plot(t_sim, x(:,2), 'k-', 'LineWidth', 1.5); hold on; %[output:7bfe45c0]
plot(t_sim, x(:,4), 'b--', 'LineWidth', 1.5); %[output:7bfe45c0]
plot(t_sim, x(:,2) - x(:,4), 'r-.', 'LineWidth', 1.5); %[output:7bfe45c0]
legend('System State x_2','Observer Estimate \xhat_2','Error x_2 - \xhat_2'); %[output:7bfe45c0]
xlabel('Time (s)'); %[output:7bfe45c0]
ylabel('Velocity (m/s)'); %[output:7bfe45c0]
title('Velocity and Observer Estimation'); %[output:7bfe45c0]
grid on; %[output:7bfe45c0]

subplot(2,2,3); %[output:7bfe45c0]
plot(t_sim, x(:,1) - x(:,3), 'r', 'LineWidth', 1.5); %[output:7bfe45c0]
xlabel('Time (s)'); %[output:7bfe45c0]
ylabel('Displacement Error (m)'); %[output:7bfe45c0]
title('Displacement Estimation Error'); %[output:7bfe45c0]
grid on; %[output:7bfe45c0]

subplot(2,2,4); %[output:7bfe45c0]
plot(t_sim, x(:,2) - x(:,4), 'r', 'LineWidth', 1.5); %[output:7bfe45c0]
xlabel('Time (s)'); %[output:7bfe45c0]
ylabel('Velocity Error (m/s)'); %[output:7bfe45c0]
title('Velocity Estimation Error'); %[output:7bfe45c0]
grid on; %[output:7bfe45c0]

sgtitle('System and Observer States with Estimation Errors'); %[output:7bfe45c0]

%%
function dX = obs_smd_x_hat(t, x, A, C, B, u, Ke)
    n = size(A,1);
    zA = zeros(n);
    zB = zeros(n,1);
    sys_x = x(1:n);      % system state
    obs_x = x(n+1:end);  % observer state
    y = C*sys_x;         % measured output

    bigA = [A zA; zA A-Ke*C];
    bigB = [B zB; B Ke];
    dX = bigA*x + bigB * [u ; y];
end

%%
[to,x] = ode45(@(t,x_hat)obs_smd_x_hat(t,x_hat,A,C,B,u,Ke),t_sim,x0);
%%
figure; %[output:45b56232]
subplot(2,2,1); plot(t_sim, x(:,1), 'k', t_sim, x(:,3), 'b--', 'LineWidth', 1.5); %[output:45b56232]
legend('x_1 (system)', 'xhat (observer)'); %[output:45b56232]
xlabel('t'); ylabel('Displacement'); %[output:45b56232]
title('Displacement: x_1 vs xhat_1'); grid on; %[output:45b56232]

subplot(2,2,2); plot(t_sim, x(:,2), 'k', t_sim, x(:,4), 'b--', 'LineWidth', 1.5); %[output:45b56232]
legend('x_2 (system)', 'xhat (observer)'); %[output:45b56232]
xlabel('t'); ylabel('Velocity'); %[output:45b56232]
title('Velocity: x_2 vs xhat'); grid on; %[output:45b56232]

subplot(2,2,3); plot(t_sim, x(:,1) - x(:,3), 'r', 'LineWidth', 1.5); %[output:45b56232]
xlabel('t'); ylabel('Error'); %[output:45b56232]
title('Displacement Error: x_1 - xhat'); grid on; %[output:45b56232]

subplot(2,2,4); plot(t_sim, x(:,2) - x(:,4), 'r', 'LineWidth', 1.5); %[output:45b56232]
xlabel('t'); ylabel('Error'); %[output:45b56232]
title('Velocity Error: x_2 - xhat'); grid on; %[output:45b56232]

sgtitle('System and Observer States with Errors') %[output:45b56232]

