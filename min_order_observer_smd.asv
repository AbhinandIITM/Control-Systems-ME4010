m1 = 1;c1 = 1;k1 = 100;
m2 = 1.5;c2 = 1;k2 = 150;
%%
A = [0 1 0 0 ; %[output:group:20759a7e] %[output:9e76caab]
    -(k1+k2)/m1 -(c1+c2)/m1 k2/m1 c2/m1; %[output:9e76caab]
    0 0 0 1; %[output:9e76caab]
    k2/m2 c2/m2 -k2/m2 -c2/m2] %[output:group:20759a7e] %[output:9e76caab]

B = [0 0 0 1/m2]' %[output:557a8da9]
C = [1 0 0 0] %[output:1ee0b007]
D = [] %[output:160039a9]
%%
p = 2.5*[-7,-7.1,-10,-11] %[output:4bf5cbaa]
Ke = place(A',C',p)';

sys = ss(A,B,C,D);
x0 = [0 0 0 0]';
x0_o = [2 1 -2 0.1]';

step(sys) %[output:02fe13cc]
